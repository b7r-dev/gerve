{{define "title"}}blame · {{.Path}} · {{.RepoName}}{{end}}
{{define "content"}}
{{template "crumbs" .}}
<div class="toolbar">
  <a href="{{urlFor "blob" .Ref .Path}}">&larr; file view</a>
  <a href="{{urlFor "history" .Ref .Path}}">history</a>
</div>
{{if .Groups}}
<div class="blame plaincode">
  <table>
    <colgroup><col class="cwho"><col class="cln"><col></colgroup>
    {{range .Groups}}
    {{$g := .}}
    {{$span := len .Lines}}
    {{range $i, $line := .Lines}}
    <tr id="L{{$line.Num}}">
      {{with blameRowspan $i $span}}<th class="bwho" scope="rowgroup" rowspan="{{.}}" title="{{$g.Commit.Subject}} · {{$g.Commit.Author}}, {{shortdatetime $g.Commit.Time}}"><span class="bwho-in"><span class="bauthor">{{$g.Commit.Author}}</span><span class="bat">@</span><a href="/commit/{{$g.Commit.Hash}}">{{if $g.Boundary}}<span class="bmark" title="boundary commit">^</span>{{end}}{{short $g.Commit.Hash}}</a></span></th>{{end}}
      <td class="ln">{{$line.Num}}</td>
      <td class="lt">{{$line.Text}}</td>
    </tr>
    {{end}}
    {{end}}
  </table>
</div>
{{else}}
<p class="muted">No lines to blame.</p>
{{end}}
{{end}}
