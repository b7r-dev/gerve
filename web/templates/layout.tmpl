{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{block "title" .}}gerve{{end}}</title>
<link rel="stylesheet" href="{{asset "app.css"}}">
<script>(function(){var t=null;try{t=localStorage.getItem("gerve-theme")}catch(e){}
if(t==="light"||(!t&&window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches)){document.documentElement.classList.add("light")}})();</script>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%235f97a8'/%3E%3Ctext x='8' y='12' font-size='10' text-anchor='middle' fill='white' font-family='monospace'%3Eg%3C/text%3E%3C/svg%3E">
</head>
<body>
<header class="top">
  <div class="brand">
    <a class="logo" href="/">gerve</a>
    <span class="sep">/</span>
    <a class="reponame" href="/">{{.RepoName}}</a>
    {{with .Head.Branch}}<span class="chip">{{.}}</span>{{end}}
    {{if .Head.Detached}}<span class="chip chip-warn">detached{{with short .Head.Hash}} at {{.}}{{end}}</span>{{end}}
  </div>
  <nav>
    {{if .Ref}}
    <form class="searchbox" action="/search/{{urlPathEscape .Ref}}" method="get">
      <input type="search" name="q" value="{{.Query}}" maxlength="200" placeholder="find" aria-label="search this repository" autocomplete="off" spellcheck="false">
      {{if .Scope}}<input type="hidden" name="path" value="{{.Scope}}">{{end}}
    </form>
    <a class="searchlink" href="/search/{{urlPathEscape .Ref}}">search</a>
    {{if ne .Route "compare"}}
    <form class="refjump" action="/refs" method="get">
      <select id="refswitch" data-base="{{.Route}}" data-path="{{.Path}}" data-query="{{.Query}}" data-scope="{{.Scope}}" aria-label="switch ref">
        <option value="{{.Ref}}" selected>{{.Ref}}</option>
        {{range .Refs}}<option value="{{.Name}}">{{.Kind}}: {{.Name}}</option>{{end}}
      </select>
      <noscript><button type="submit">go</button></noscript>
    </form>
    {{end}}
    <a href="/commits/{{urlPathEscape .Ref}}">commits</a>
    {{end}}
    <a href="/refs">refs</a>
    {{if .Share.Enabled}}
    <button id="shareBtn" type="button" aria-haspopup="dialog" aria-controls="shareDialog" title="share this page" hidden>share</button>
    {{end}}
    <button id="themeBtn" type="button" title="toggle theme" aria-label="toggle theme">◐</button>
  </nav>
</header>
<main>
{{block "content" .}}{{end}}
</main>
{{if .Share.Enabled}}
<dialog id="shareDialog" class="share" data-public-url="{{.Share.PublicURL}}" aria-labelledby="shareTitle">
  <div class="share-head">
    <h2 id="shareTitle">share this page</h2>
    <button type="button" id="shareClose" class="share-close" aria-label="close">×</button>
  </div>
  <p class="share-warning">Anyone who can reach these addresses can read this repository. There is no authentication.</p>
  <div class="share-field">
    <label for="sharePublicURL">public URL</label>
    <input id="sharePublicURL" type="url" inputmode="url" placeholder="http://host:8080" value="{{.Share.PublicURL}}" spellcheck="false" autocomplete="off">
    <p class="share-hint">Saved in this browser. Leave empty to use the detected addresses.</p>
  </div>
  <ul id="shareList" class="share-list"></ul>
  <p id="shareEmpty" class="share-empty" hidden>No reachable addresses are available.</p>
  <div id="shareQR" class="share-qr-panel" hidden>
    <div id="shareQRCode" class="share-qr-code"></div>
    <p id="shareQRLabel" class="share-qr-label"></p>
  </div>
  <div id="shareOrigins" hidden>{{range .Share.Origins}}<span data-origin="{{.}}"></span>{{end}}</div>
</dialog>
{{end}}
<footer>
  <div class="dot-rule" aria-hidden="true">· · · · ·</div>
  gerve {{.Version}} · read-only view of {{.RepoName}}
</footer>
{{if .Share.Enabled}}<script src="{{asset "qrcode.js"}}"></script>{{end}}
<script src="{{asset "app.js"}}"></script>
</body>
</html>{{end}}
