{{define "title"}}refs · {{.RepoName}}{{end}}
{{define "content"}}
<form class="compareform" action="/compare/" method="get">
  <span class="muted">compare</span>
  <select name="base" aria-label="base ref">
    {{range .Refs}}<option value="{{.Name}}">{{.Kind}}: {{.Name}}</option>{{end}}
  </select>
  <span class="muted">...</span>
  <select name="head" aria-label="head ref">
    {{range .Refs}}<option value="{{.Name}}">{{.Kind}}: {{.Name}}</option>{{end}}
  </select>
  <button type="submit">go</button>
</form>
<h2 class="panel-label">branches</h2>
<table class="listing">
  {{range .Branches}}
  <tr>
    <td class="name"><a href="{{urlFor "tree" .Name ""}}">{{.Name}}</a></td>
    <td class="msg">{{with .Info}}<a class="muted" href="/commit/{{.Hash}}">{{.Subject}}</a>{{end}}</td>
    <td class="age muted">{{with .Info}}{{timeago .Time}}{{end}}</td>
  </tr>
  {{else}}<tr><td class="muted empty-row">no branches</td></tr>{{end}}
</table>
<h2 class="panel-label">tags</h2>
<table class="listing">
  {{range .Tags}}
  <tr>
    <td class="name"><a href="{{urlFor "tree" .Name ""}}">{{.Name}}</a></td>
    <td class="msg">{{with .Info}}<a class="muted" href="/commit/{{.Hash}}">{{.Subject}}</a>{{end}}</td>
    <td class="age muted">{{with .Info}}{{timeago .Time}}{{end}}</td>
  </tr>
  {{else}}<tr><td class="muted empty-row">no tags</td></tr>{{end}}
</table>
{{end}}
